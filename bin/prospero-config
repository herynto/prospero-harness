#!/usr/bin/env bash
# Show or change config.json, the preferences dispatch-hook.sh applies to each verdict.
#   prospero-config show                      table of every pair and both switches
#   prospero-config set <from> <to>           e.g. config set opus/medium fable/low
#   prospero-config switch <name> <true|false>   name: override_chosen | swap_agents
#   prospero-config mode [name]               how the classifier weighs doubt: balanced, or any modes/<name>.md
#   prospero-config reset                     every pair maps to itself, switches back to default
#   prospero-config edit                      arrow-key menu for all of the above; run it in a terminal
set -uo pipefail
# ~/.prospero/bin/prospero-config is a symlink to this file; follow it to find modes/.
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
dir="$(cd "$(dirname "$self")/.." && pwd)"
file="${PROSPERO_CONFIG:-${PROSPERO_HOME:-$HOME/.prospero}/config.json}"
mkdir -p "$(dirname "$file")"
pair='^(haiku|sonnet|opus|fable)/(low|medium|high)$'

defaults() {
  jq -n '{pairs: ([("haiku","sonnet","opus","fable") as $m | ("low","medium","high") as $e
    | {key:"\($m)/\($e)", value:"\($m)/\($e)"}] | from_entries), mode:"balanced", override_chosen:false, swap_agents:true}'
}
modes() { echo balanced; for f in "$dir"/modes/*.md; do [ -f "$f" ] && basename "$f" .md; done; }
mode_now() { jq -r '.mode // "balanced"' "$file"; }
save() { local tmp; tmp="$(mktemp)"; cat > "$tmp" && mv "$tmp" "$file"; }
die() { echo "prospero-config: $*" >&2; exit 1; }

# menu <title> <option>...: arrow keys or j/k move, Enter picks, q goes back.
# Sets MENU_IDX to the picked index, or -1. Draws on stderr, reads keys from stdin.
menu() {
  local title="$1" key rest i n cur=0; shift; n=$#
  MENU_IDX=-1
  while :; do
    printf '\033[1m%s\033[0m\n' "$title" >&2
    i=0; for opt in "$@"; do
      if [ "$i" -eq "$cur" ]; then printf '\033[7m> %s\033[0m\n' "$opt" >&2; else printf '  %s\n' "$opt" >&2; fi
      i=$((i+1))
    done
    IFS= read -rsn1 key || return 0
    if [ "$key" = $'\033' ]; then IFS= read -rsn2 -t 1 rest || rest=""; key="$key$rest"; fi
    case "$key" in
      $'\033[A'|k) cur=$(( (cur + n - 1) % n )) ;;
      $'\033[B'|j) cur=$(( (cur + 1) % n )) ;;
      "") MENU_IDX=$cur; key=done ;;
      q|$'\033') key=done ;;
    esac
    printf '\033[%dA\033[J' "$((n+1))" >&2
    [ "$key" = done ] && return 0
  done
}

edit() {
  [ -t 0 ] || [ -n "${PROSPERO_MENU_TEST:-}" ] || die "edit needs a terminal; from Claude Code use: prospero-config set <from> <to>"
  local models="haiku sonnet opus fable" efforts="low medium high" keys=() rows=() k v m e on
  while :; do
    keys=(); rows=()
    for m in $models; do for e in $efforts; do
      k="$m/$e"; v="$(jq -r --arg k "$k" '.pairs[$k] // $k' "$file")"
      keys+=("$k"); rows+=("$(printf '%-14s -> %-14s%s' "$k" "$v" "$([ "$v" = "$k" ] || echo ' *')")")
    done; done
    rows+=("mode            = $(mode_now)" "override_chosen = $(jq -r '.override_chosen == true' "$file")" "swap_agents     = $(jq -r '.swap_agents != false' "$file")" "Reset everything" "Quit")
    menu "Prospero preferences: verdict -> what runs   (Enter change, q quit)" "${rows[@]}"
    case "$MENU_IDX" in
      -1|16) return 0 ;;
      12)
        set -- $(modes); menu "Classifier mode (now: $(mode_now))" "$@"; [ "$MENU_IDX" -ge 0 ] || continue
        shift "$MENU_IDX"; jq --arg v "$1" '.mode = $v' "$file" | save ;;
      13|14)
        [ "$MENU_IDX" -eq 13 ] && k=override_chosen || k=swap_agents
        on="$(jq -r --arg k "$k" 'if $k == "swap_agents" then .[$k] != false else .[$k] == true end' "$file")"
        [ "$on" = true ] && on=false || on=true
        jq --arg k "$k" --argjson v "$on" '.[$k] = $v' "$file" | save ;;
      15) menu "Reset every pair and both switches?" "No" "Yes"; [ "$MENU_IDX" -eq 1 ] && defaults | save ;;
      *)
        k="${keys[$MENU_IDX]}"
        menu "$k: which model should run instead?" $models; [ "$MENU_IDX" -ge 0 ] || continue
        set -- $models; shift "$MENU_IDX"; m="$1"
        menu "$k -> $m: at which effort?" $efforts; [ "$MENU_IDX" -ge 0 ] || continue
        set -- $efforts; shift "$MENU_IDX"; e="$1"
        jq --arg k "$k" --arg v "$m/$e" '.pairs[$k] = $v' "$file" | save ;;
    esac
  done
}

[ -s "$file" ] || defaults | save
jq -e 'type == "object"' "$file" >/dev/null 2>&1 || die "$file is not valid JSON; run: prospero-config reset"

case "${1:-show}" in
  show)
    defaults | jq -r --slurpfile c "$file" '
      (.pairs | keys_unsorted[]) as $k | ($c[0].pairs[$k] // $k) as $v
      | "\($k)\t->\t\($v)" + (if $v == $k then "" else "\t*" end)' | column -t -s "$(printf '\t')"
    jq -r '"mode            = \(.mode // "balanced")\noverride_chosen = \(.override_chosen == true)\nswap_agents     = \(.swap_agents != false)"' "$file" ;;
  set)
    [[ "${2:-}" =~ $pair ]] || die "bad pair '${2:-}', want <model>/<effort>, e.g. opus/medium"
    [[ "${3:-}" =~ $pair ]] || die "bad pair '${3:-}', want <model>/<effort>, e.g. fable/low"
    jq --arg k "$2" --arg v "$3" '.pairs[$k] = $v' "$file" | save; echo "$2 -> $3" ;;
  switch)
    case "${2:-}" in override_chosen|swap_agents) ;; *) die "unknown switch '${2:-}'" ;; esac
    case "${3:-}" in true|false) ;; *) die "value must be true or false" ;; esac
    jq --arg k "$2" --argjson v "$3" '.[$k] = $v' "$file" | save; echo "$2 = $3" ;;
  mode)
    if [ -z "${2:-}" ]; then
      for m in $(modes); do [ "$m" = "$(mode_now)" ] && echo "* $m" || echo "  $m"; done
    else
      # No pipe into grep -q here: it quits at the first match, modes dies of SIGPIPE,
      # and pipefail turns a found mode into a failure.
      case $'\n'"$(modes)"$'\n' in *$'\n'"$2"$'\n'*) ;; *) false ;; esac || die "unknown mode '$2', have: $(modes | tr '\n' ' ')"
      jq --arg v "$2" '.mode = $v' "$file" | save; echo "mode = $2"
    fi ;;
  reset) defaults | save; echo "reset" ;;
  edit) edit ;;
  *) die "usage: prospero-config show | edit | set <from> <to> | mode [name] | switch <name> <true|false> | reset" ;;
esac
