{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hook.sh", "timeout": 60 }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/dispatch-hook.sh", "timeout": 60 }]
      }
    ]
  }
}
